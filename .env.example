# Copy to .env (never commit .env). Defaults give a zero-config local run.
APP_ENV=development            # production refuses to start with a weak JWT_SECRET
JWT_SECRET=                    # 32+ random chars; required when APP_ENV=production
DATABASE_URL=sqlite:///./nexus.db   # or postgresql+psycopg2://user:pass@host/db
QUEUE_BACKEND=db               # db | celery
REDIS_URL=redis://localhost:6379/0
STORAGE_BACKEND=local          # local | s3
S3_BUCKET=nexus-documents
S3_ENDPOINT_URL=               # set for an S3-compatible server; empty for AWS
AWS_REGION=us-east-1
ANTHROPIC_API_KEY=             # empty = offline extractive mode
LLM_MODE=auto
EMBEDDING_BACKEND=auto         # auto | hash | st
RERANK_ENABLED=false
LOG_FORMAT=text                # text | json
