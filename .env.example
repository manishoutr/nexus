# Copy to .env or export these variables. No secrets are committed.

# Database. Default is a local SQLite file (zero setup).
# For PostgreSQL (e.g. via docker-compose), use:
#   DATABASE_URL=postgresql+psycopg2://nexus:nexus@localhost:5432/nexus
DATABASE_URL=sqlite:///./nexus.db

# Claude API. Without a key the app runs in OFFLINE mode: grounded answers are
# assembled deterministically from retrieved passages and labelled offline.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# auto: use Claude when a key is present, else offline. claude: require key. offline: never call the API.
LLM_MODE=auto

# Where uploaded originals are stored.
DATA_DIR=./data

# Upload limits
MAX_UPLOAD_MB=10
